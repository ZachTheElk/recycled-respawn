---
import { Image } from 'astro:assets';
import rrMark from '../assets/rr-mark-1600.png';
---

<header class="site-header">
	<div class="masthead-row">
		<div class="brand-mark-slot" aria-hidden="true">
			<Image src={rrMark} alt="" widths={[52, 76, 104, 152]} sizes="(max-width: 46rem) 52px, (max-width: 68rem) 7vw, 76px" />
		</div>
		<a class="wordmark" href="/" aria-label="Recycled Respawn home">RECYCLED RESPAWN</a>
	</div>

	<div class="navigation-row">
		<p class="navigation-label" id="primary-navigation-label">Sections</p>
		<nav class="primary-navigation" aria-labelledby="primary-navigation-label">
			<a href="/gaming/">Gaming</a>
			<a href="/culture/">Culture</a>
			<a href="/features/">Features</a>
		</nav>
	</div>
</header>
