---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: URL;
	ogType?: 'website' | 'article';
	socialImage?: URL;
	socialImageWidth?: number;
	socialImageHeight?: number;
	socialImageType?: string;
	publishedAt?: Date;
	updatedAt?: Date;
	noindex?: boolean;
	structuredData?: Record<string, unknown>;
}

const {
	title = 'Recycled Respawn',
	description = 'An independent gaming and culture publication.',
	canonicalUrl,
	ogType = 'website',
	socialImage,
	socialImageWidth,
	socialImageHeight,
	socialImageType,
	publishedAt,
	updatedAt,
	noindex = false,
	structuredData,
} = Astro.props;

// Ordinary website pages share the brand image; articles (including drafts) never fall back.
const defaultSocialImage = new URL('/og-default.png', Astro.site);
const resolvedSocialImage = socialImage ?? (ogType === 'website' && !noindex ? defaultSocialImage : undefined);
const usesDefaultSocialImage = resolvedSocialImage?.href === defaultSocialImage.href;
const resolvedImageWidth = socialImageWidth ?? (usesDefaultSocialImage ? 1200 : undefined);
const resolvedImageHeight = socialImageHeight ?? (usesDefaultSocialImage ? 630 : undefined);
const resolvedImageType = socialImageType ?? (usesDefaultSocialImage ? 'image/png' : undefined);
// Keep author-controlled text inside the JSON-LD script even if it contains a less-than sign.
const structuredDataJson = structuredData ? JSON.stringify(structuredData).replace(/</g, '\u003c') : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="alternate" type="application/rss+xml" title="Recycled Respawn" href={new URL('rss.xml', Astro.site)} />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{resolvedSocialImage && <meta property="og:image" content={resolvedSocialImage} />}
		{resolvedSocialImage && resolvedImageWidth && <meta property="og:image:width" content={resolvedImageWidth} />}
		{resolvedSocialImage && resolvedImageHeight && <meta property="og:image:height" content={resolvedImageHeight} />}
		{resolvedSocialImage && resolvedImageType && <meta property="og:image:type" content={resolvedImageType} />}
		<meta name="twitter:card" content={resolvedSocialImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{resolvedSocialImage && <meta name="twitter:image" content={resolvedSocialImage} />}
		{structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
		{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
		{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
