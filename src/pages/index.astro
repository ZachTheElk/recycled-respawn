---
import FeaturedStory from '../components/FeaturedStory.astro';
import NewestColumn from '../components/NewestColumn.astro';
import Layout from '../layouts/Layout.astro';

// Development-only sample data. Replace with approved editorial content in a later task.
const featuredStory = {
	section: 'Gaming',
	headline: 'When a Familiar Game Becomes a Place Worth Returning To',
	dek: 'A layout test exploring how memory, routine, and changing player expectations can reshape the way an old favorite feels years later.',
	author: 'Development sample — not ZachTheElk',
	publicationDate: 'Sample date: September 5, 2026',
	readTime: '6 min read sample',
	image: {
		alt: 'Development-only image placeholder; final editorial image has not been selected.',
	},
	developmentOnly: true,
};

// Development-only sample data. “Column” and “Opinion” remain provisional labels.
const newestColumn = {
	label: 'Newest Column',
	section: 'Opinion',
	headline: 'The Ritual of Choosing What to Play Is Half the Experience',
	dek: 'A development-only layout sample about the anticipation, indecision, and small personal rituals that can matter as much as pressing Start.',
	author: 'Development sample — not ZachTheElk',
	publicationDate: 'Sample date: September 5, 2026',
	readTime: '4 min read sample',
	developmentOnly: true,
};
---

<Layout>
	<a class="skip-link" href="#main-content">Skip to main content</a>

	<div class="site-frame">
		<header class="site-header">
			<div class="masthead-row">
				<div class="brand-mark-slot" aria-hidden="true"></div>
				<a class="wordmark" href="/" aria-label="Recycled Respawn home">RECYCLED RESPAWN</a>
			</div>

			<div class="navigation-row">
				<p class="navigation-label" id="primary-navigation-label">Sections</p>
				<nav class="primary-navigation" aria-labelledby="primary-navigation-label">
					<span aria-disabled="true" title="Section in development">Gaming</span>
					<span aria-disabled="true" title="Section in development">Culture</span>
					<span aria-disabled="true" title="Section in development">Features</span>
				</nav>
				<p class="navigation-status">Section pages are in development.</p>
			</div>
		</header>

		<div class="publication-grid">
			<main class="main-region" id="main-content" tabindex="-1">
				<FeaturedStory {...featuredStory} />
				<NewestColumn {...newestColumn} />
			</main>

			<aside class="right-rail" aria-labelledby="right-rail-title">
				<div class="rail-placeholder">
					<p class="panel-label">Right rail</p>
					<h2 id="right-rail-title">Supporting publication space</h2>
					<p>Future modules will be defined separately.</p>
				</div>
			</aside>
		</div>

		<footer class="site-footer">
			<p><strong>Recycled Respawn</strong></p>
			<p>Independent gaming and culture publication.</p>
		</footer>
	</div>
</Layout>
