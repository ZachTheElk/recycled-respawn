---
import FeaturedStory from '../components/FeaturedStory.astro';
import GamingSection from '../components/GamingSection.astro';
import CultureSection from '../components/CultureSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import NewestColumn from '../components/NewestColumn.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getHomepageStories } from '../data/homepage';
import Layout from '../layouts/Layout.astro';

const { featuredStory, newestColumn, gamingSection, cultureSection, featuresSection } = await getHomepageStories();

const featuredProps = {
	...featuredStory,
	section: featuredStory.displaySection,
	image: featuredStory.image ?? { alt: 'Development-only image placeholder; final editorial image has not been selected.' },
};

const columnProps = { ...newestColumn, label: 'Newest Column', section: newestColumn.formatLabel ?? 'Opinion' };

const gamingProps = {
	...gamingSection,
	leadStory: {
		...gamingSection.leadStory,
		image: gamingSection.leadStory.image ?? { alt: 'Development-only Gaming image placeholder; no editorial image has been selected.' },
	},
	developmentOnly: true,
};

const cultureProps = {
	...cultureSection,
	leadStory: {
		...cultureSection.leadStory,
		image: cultureSection.leadStory.image ?? { alt: 'Development-only Culture image placeholder; no editorial image has been selected.' },
	},
	briefs: cultureSection.briefs.map((story) => ({ ...story, label: story.formatLabel })),
	developmentOnly: true,
};

const featuresProps = {
	primaryStory: { ...featuresSection.primaryStory, label: featuresSection.primaryStory.formatLabel },
	secondaryStories: featuresSection.secondaryStories.map((story) => ({ ...story, label: story.formatLabel })),
	developmentOnly: true,
};
---

<Layout>
	<a class="skip-link" href="#main-content">Skip to main content</a>
	<div class="site-frame">
		<SiteHeader />
		<div class="publication-grid">
			<main class="main-region" id="main-content" tabindex="-1">
				<FeaturedStory {...featuredProps} />
				<NewestColumn {...columnProps} />
				<GamingSection {...gamingProps} />
				<CultureSection {...cultureProps} />
				<FeaturesSection {...featuresProps} />
			</main>
			<aside class="right-rail" aria-labelledby="right-rail-title">
				<div class="rail-placeholder">
					<p class="panel-label">Right rail</p>
					<h2 id="right-rail-title">Supporting publication space</h2>
					<p>Future modules will be defined separately.</p>
				</div>
			</aside>
		</div>
		<SiteFooter />
	</div>
</Layout>
